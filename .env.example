# Claude API キー。未設定でもアプリは動作しますが、全出力がルールベースの整形に
# 劣化します（エラーにはなりません）。デプロイ後は「整形後」ペインのバッジが
# "Claude Opus 5" になっているか必ず確認してください。
# NEXT_PUBLIC_ を付けないこと（ブラウザに露出します）。
ANTHROPIC_API_KEY=

# レート制限。公開URLでは /api/polish が「誰でも運営者の鍵で Claude を呼べる口」
# になるため、既定で 1 IP あたり 5 分間に 20 回に制限しています。
# RATE_LIMIT_MAX=20          # 0 で無効化
# RATE_LIMIT_WINDOW_MS=300000

# 企業プロキシの内側で使う場合。Node の fetch は HTTPS_PROXY を自動では読みません。
# NODE_USE_ENV_PROXY=1
